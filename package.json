{
  "name": "hide-and-seek",
  "private": true,
  "version": "0.1.3",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "prebuild": "npm run check:node",
    "build": "npm run build --workspaces --if-present",
    "pretest": "npm run check:node",
    "test": "node --test tools/field-test-analyzer.test.mjs && npm run test --workspaces --if-present",
    "pretypecheck": "npm run check:node",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "predev:mobile": "npm run check:node",
    "dev:mobile": "npm run start --workspace @hide-and-seek/mobile",
    "predev:server": "npm run check:node",
    "dev:server": "npm run dev --workspace @hide-and-seek/game-server",
    "preanalyze:field-test": "npm run check:node",
    "analyze:field-test": "node tools/field-test-analyzer.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "uuid": "11.1.1"
  }
}
