# Android emulator default. Use your computer's LAN IP for physical phones.
EXPO_PUBLIC_GAME_API_URL=http://10.0.2.2:8787

# Restrict this key in Google Cloud to the Android package and signing certificate.
GOOGLE_MAPS_API_KEY=

# Optional during local development. Add a Sentry React Native DSN to collect
# JavaScript and native crash reports from installed beta builds.
EXPO_PUBLIC_SENTRY_DSN=
