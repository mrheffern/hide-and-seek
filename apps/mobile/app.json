{
  "expo": {
    "name": "Out of Sight",
    "slug": "out-of-sight",
    "scheme": "outofsight",
    "version": "0.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hideandseek.outofsight",
      "infoPlist": {
        "NSAllowsLocalNetworking": true
      }
    },
    "android": {
      "package": "com.hideandseek.outofsight",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Out of Sight uses your location while a match is running.",
          "locationAlwaysAndWhenInUsePermission": "Out of Sight uses your location during a match, including while your phone is locked.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "@sentry/react-native"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "gameApiUrl": "https://hide-and-seek-game-server.hide-and-seek-game-server.workers.dev"
    }
  }
}
